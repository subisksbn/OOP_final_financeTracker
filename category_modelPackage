package model;

public enum Category {
    FOOD_GROCERIES("Food & Groceries"),
    UTILITIES("Utilities"),
    ENTERTAINMENT("Entertainment"),
    SUBSCRIPTIONS("Auto-renewal Subscriptions");
    //open for extension..

    private final String displayName;

    Category(String displayName) {
        this.displayName = displayName;
    }

    public String getDisplayName() {
    	return displayName;
    }
    // display all categories as a numbered menu
    public static void printMenu() {
        Category[] values = Category.values();
        for (int i = 0; i < values.length; i++) {
            System.out.println((i + 1) + ". " + values[i].getDisplayName());
        }
    }

    // map menu number to a category
    public static Category fromChoice(int choice) {
        Category[] choices = Category.values();
        if(choice < 1 || choice > choices.length){
            System.out.println("Invalid category choice.");
            return null;
        }else {
            return choices[choice-1];
        }
        /*if (choice == 1) {
            return Category.FOOD_GROCERIES;
        } else if (choice == 2) {
