package service;

import model.Category;
import model.Expense;
import model.User;

import java.time.LocalDate;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;

public class ExpenseService {

    // Add expense to user's list
    public void addExpense(User user, Expense expense) {
        user.addExpense(expense);
    }

    // Sum all expenses for given category
    public double getTotalByCategory(User user, Category category) {
        double total = 0;
        for (Expense e : user.getExpensesByCategory(category)) {
            total += e.getAmount();
        }
        return total;
    }

    // Sort by DATE (newest first), AMOUNT (highest first), or CATEGORY (A-Z)
    public List<Expense> sortExpenses(User user, SortCriteria criteria) {
        List<Expense> sorted = new ArrayList<>(user.getExpenses());

        switch (criteria) {
            case DATE:
                sorted.sort(Comparator.comparing(Expense::getDate).reversed());
                break;
            case AMOUNT:
                sorted.sort(Comparator.comparingDouble(Expense::getAmount).reversed());
                break;
            case NAME:
            	sorted.sort(Comparator.comparing(Expense::getName));
                break;
        }

        return sorted;
    }
    
    // Find transaction - matching description, amount, and date (returns first match)
    public Expense findExpense(User user, String name, double amount, LocalDate date) {
    	for (Expense e: user.getExpenses()) {
    		if (e.getName().equalsIgnoreCase(name) && e.getAmount() == amount && e.getDate().equals(date)) {
    			return e;
    		}
    	}
    	return null;
    }
    
    // Delete selected transaction return true if removed and false if not found
    public boolean deleteExpense(User user, Expense selected) {
    	return user.getExpenses().remove(selected);
    }
    
    // Edit selected transaction
    
    public void editExpense(Expense expense, String newName, Double newAmount, Category newCategory, LocalDate newDate) {
    	if (newName != null && !newName.isBlank()) {
    		expense.setName(newName);
    	}
    	if (newAmount != null) {
    		expense.setAmount(newAmount);
    	}
    	if (newCategory != null) {
    		expense.setCategory(newCategory);
    	}
    	if (newDate != null) {
    		expense.setDate(newDate);
    	}
    }

    // Enum for sort options
    public enum SortCriteria {
        DATE, AMOUNT, NAME
    }
}
