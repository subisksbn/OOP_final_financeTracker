package ui;

import java.time.LocalDate;
import java.util.List;
import java.util.Scanner;

// system objects
import model.Category;
import model.Expense;
import model.User;
// services
import service.*;
import service.ExpenseService.SortCriteria;

public class MainMenu {
    private Scanner sc = new Scanner(System.in);

    private DataManager dataManager;
    private LoginService loginService;
    private ExpenseService expenseService;
    private BudgetService budgetService;

    private List<User> allUsers;
    private User currentUser;

    public MainMenu() {
        dataManager = new DataManager();
        allUsers = dataManager.loadUsers();
        loginService = new LoginService(allUsers);
        expenseService = new ExpenseService();
        budgetService = new BudgetService(expenseService);
    }

    // mount the menu to the screen
    public void showMenu() {
        printTitle();
        while (true) { //<--
            if (currentUser == null) {
                showGuestMenu();
            } else {
                showUserMenu();
            }
        }
    }

    // UI for un-authenticated user
    private void showGuestMenu() {
        System.out.println("\n1. Login");
        System.out.println("2. Exit");
        System.out.print("Choice: ");
        // the user can login with their credentials 
        // or exit
        switch (sc.nextLine().trim()) {
            case "1" -> handleLogin();
            case "2" -> exitApp();
            default -> System.out.println("Invalid choice.");
        }
    }

    // UI for authenticated user
    private void showUserMenu() {
        System.out.println("\n=============================");
        System.out.println("  Hello, " + currentUser.getUsername() + "!");
        System.out.println("=============================");
        System.out.println("""
                1. Add expense
                2. Edit a transaction
                3. Delete a transaction
                4. Set budget limit
                5. View spending summary
                6. Sort and view transactions
                7. Logout (saves data)
        """);
        /*System.out.println("1. Add expense");
        System.out.println("2. Edit a transaction");
        System.out.println("3. Delete a transaction");
        System.out.println("4. Set budget limit");
        System.out.println("5. View spending summary");
        System.out.println("6. Sort and view transactions");
        System.out.println("7. Logout (saves data)");*/
        System.out.print("Choice: ");
        
        // get choice, trigger appropriate action
        switch (sc.nextLine().trim()) {
            case "1" -> handleAddExpense();
            case "2" -> handleEditTransaction();
            case "3" -> handleDeleteTransaction(); 
            case "4" -> handleSetBudget();
            case "5" -> handleViewSummary();
            case "6" -> handleSortTransactions();
            case "7" -> handleLogout();
            default -> System.out.println("Invalid choice.");
        }
    }

    // Login
    public void handleLogin() {
        System.out.print("Username: ");
        String username = sc.nextLine().trim();
        System.out.print("Password: ");
        String password = sc.nextLine().trim();

        // authenticate user
        User user = loginService.login(username, password);

        if (user != null) {
            currentUser = user;
            //System.out.println("\n" + currentUser.getUsername() + "is logged in.");
            System.out.printf("\n%s is logged in", currentUser.getUsername());
        } else {
            System.out.println("Invalid username or password. Try again.");
        }
    }

    // add Expense
    public void handleAddExpense() {
        System.out.println("\n-- Add Expense --");

        System.out.print("Description (e.g. Trader Joe's): ");
        String name = sc.nextLine().trim();
    
        double amount = promptDouble("Amount ($): ");

        System.out.println("Category:");
        Category.printMenu();
        int catChoice = (int) promptDouble("Choose (1-" + Category.values().length + "): ");
       
        // use the object's methods
        Category category = Category.fromChoice(catChoice);
        if (category == null) {
            return;
        }
        
        // add a  date
        System.out.print("Date (YYYY-MM-DD) or press Enter for today: ");
        String inputDate = sc.nextLine().trim();
        LocalDate date;
        if (inputDate.isEmpty()) {
        	date = LocalDate.now();
        } else {
        	date= LocalDate.parse(inputDate);
        }

        // Check budget before adding
        if (budgetService.checkBudget(currentUser, category, amount)) {
            System.out.printf("\n*** WARNING: You have exceeded your monthly budget for %s! ***\n",
                category.getDisplayName());
        }

        Expense expense = new Expense(name, amount, category, date);
        expenseService.addExpense(currentUser, expense);
        System.out.println("Expense added: " + expense);
    }
    
    // Edit a Transaction
    public void handleEditTransaction() {
    	if (currentUser.getExpenses().isEmpty()) {
    		System.out.println("No transcations to edit!");
    		return;
    	}
    	
    	System.out.println("\n-- Edit a Transaction --");
    	printAllTransactions(); 
    	
    	Expense selected = selectExpense();
    	
    	if (selected == null) {
    		return;
    	}
    	
    	System.out.println("\nSelected: " + selected);
        System.out.println("""
        \nChoose criteria to change:
        1. Description
        2. Amount
        3. Category
        4. Date
        """);
    	/*System.out.println("\nChoose criteria to change:");
    	System.out.println("1. Description");
    	System.out.println("2. Amount");
    	System.out.println("3. Category");
    	System.out.println("4. Date");*/
    	
    	String newName = null;
    	Double newAmount = null;
    	Category newCategory = null;
    	LocalDate newDate = null;
    	
        // get choice
    	switch (sc.nextLine().trim()) {
	    	case "1" -> {
	    		System.out.print("New description: ");
	    		newName = sc.nextLine().trim();
	    	}
	    	case "2" -> {
	    		newAmount = promptDouble("New amount ($): ");
	    	}
	    	
	    	case "3" -> {
	    		System.out.println ("New category: ");
	    		Category.printMenu();
	    		int catChoice = (int) promptDouble("Choose (1-" + Category.values().length + "): ");
	    		newCategory = Category.fromChoice(catChoice);
	    		if (newCategory == null) {
	    			return;
	    		}
	    	}
	    	case "4" -> {
	    		System.out.print("New Date (YYYY-MM-DD): ");
	    		String inputDate = sc.nextLine().trim();
	    		newDate = LocalDate.parse(inputDate);
	    		
	    	}
	    	default -> {
	    		System.out.println("Invalid choice.");
	    		return;
	    	}
    	}
    	expenseService.editExpense(selected, newName, newAmount, newCategory, newDate);
    	System.out.println("Transaction successfully updated: " + selected);
    }
    
    // Delete a transaction
    public void handleDeleteTransaction() {
    	if (currentUser.getExpenses().isEmpty()) {
    		System.out.println("No transactions to delete!");
    		return;
    	}
    	System.out.println("\n-- Delete a Transaction --");
    	printAllTransactions();
    	
    	Expense selected = selectExpense();
    	if (selected == null) {
    		return; 
    	}
    	
    	System.out.println("\nSelected: " + selected);
    	System.out.print("Are you sure you want to delete this transaction? (y/n): ");
    	
    	String confirm = sc.nextLine().trim();
    	
    	if (confirm.equalsIgnoreCase("y")) {
    		expenseService.deleteExpense(currentUser, selected);
    		System.out.println("Transaction successfully deleted.");
    	} else {
    		System.out.println("Delete cancelled");
    	}
    }
    

    // set Budget
    public void handleSetBudget() {
        System.out.println("\n-- Set Monthly Budget Limit --");
        System.out.println("Categories:");
        Category.printMenu();

        int catChoice = (int) promptDouble("Choose category (1-" + Category.values().length + "): ");
        
        Category category = Category.fromChoice(catChoice);
        if (category == null) {
            return;
        }

        double limit = promptDouble("Monthly limit for " + category.getDisplayName() + " ($): ");
        budgetService.setBudgetLimit(currentUser, category, limit);
        System.out.println("Budget set: $" + String.format("%.2f", limit) + " for " + category.getDisplayName());
    }

    // view summary of all expenses
    public void handleViewSummary() {
        System.out.println("\n======= SPENDING SUMMARY =======");
        // format columns/table headers
        System.out.printf("%-28s %10s %12s %12s%n", "Category", "Spent", "Budget", "Remaining");
        System.out.println("-".repeat(64));

        double grandTotal = 0;
        // sum of all expenses for each category
        for (Category c : Category.values()) {
            double spent = expenseService.getTotalByCategory(currentUser, c);
            double remaining = budgetService.getRemainingBudget(currentUser, c);
            double limit = currentUser.getBudget(c).getLimit();
            grandTotal += spent;
            
            String budgetStr = (limit > 0) ? String.format("$%, .2f", limit) : "not set";
            /*if (limit > 0) {
            	budgetStr = String.format("$%, .2f", limit);
            } else {
            	budgetStr = "not set";
            }*/
            
            String[] values = {
                "  --",
                String.format("-$%,.2f !!!", Math.abs(remaining)),
                String.format("$%,.2f", remaining)
            };
            String remainingStr = values[(limit <= 0) ? 0 : (
                (remaining < 0) ? 1 : 2)];
            
            /*if (limit <= 0) {
            	remainingStr = "  --";
            } else if (remaining < 0) {
            	remainingStr = String.format("-$%,.2f !!!", Math.abs(remaining));
            } else {
            	remainingStr = String.format("$%,.2f", remaining);
            }*/
            
            System.out.printf("%-28s %10s %12s %12s%n", 
                c.getDisplayName(), 
                String.format("$%,.2f", spent), 
                budgetStr, 
                remainingStr);
        }

        System.out.println("-".repeat(64));
        System.out.printf("%-28s %10s%n", 
            "TOTAL SPENT", 
            String.format("$%,.2f", grandTotal));
    }

    // sorting transactions
    public void handleSortTransactions() {
        if (currentUser.getExpenses().isEmpty()) {
            System.out.println("No transactions to display.");
            return;
        }

        System.out.println("\n-- Sort By (choose an option) --");
        System.out.println("1. Date (newest first)");
        System.out.println("2. Amount (highest first)");
        System.out.println("3. Name (A-Z)");
        System.out.print("Choice: ");

        SortCriteria criteria;
        switch (sc.nextLine().trim()) {
            case "1" -> criteria = SortCriteria.DATE;
            case "2" -> criteria = SortCriteria.AMOUNT;
            case "3" -> criteria = SortCriteria.NAME;
            default -> {
            	System.out.println("Invalid choice."); return;
            }
        }

        List<Expense> sorted = expenseService.sortExpenses(currentUser, criteria);

        System.out.println();
        System.out.printf("  %-20s %-26s %10s  %s%n", "Description", "Category", "Amount", "Date");
        System.out.println("  " + "-".repeat(70));
        for (Expense e : sorted) {
            System.out.println(e);
        }
    }

    // Logout (save data)

    public void handleLogout() {
        dataManager.saveUsers(allUsers);
        System.out.println("Data saved. Goodbye, " + currentUser.getUsername() + "!");
        currentUser = null;
    }

    // Exit Program

    private void exitApp() {
        if (currentUser != null) {
            dataManager.saveUsers(allUsers);
        }
        System.out.println("Goodbye!");
        System.exit(0);
    }

    // Helpers
    
    private void printAllTransactions() {
    	List<Expense> expenses = expenseService.sortExpenses(currentUser, SortCriteria.DATE);
    	System.out.println();
    	System.out.printf("  %-20s %-26s %10s  %s%n", "Description", "Category", "Amount", "Date");
        System.out.println("  " + "-".repeat(70));
        for (Expense e : expenses) {
            System.out.println(e);
        }
    }
    
    private Expense selectExpense() {
    	System.out.println("\n Enter the information of transaction you wish to select: ");
    	System.out.print("Description: ");
    	String name = sc.nextLine().trim();
    	
    	double amount = promptDouble("Amount ($): ");
    	
    	System.out.print("Date (YYYY-MM-DD): ");
    	LocalDate date = LocalDate.parse(sc.nextLine().trim());
    	
    	Expense found = expenseService.findExpense(currentUser, name, amount, date);
    	if (found == null) {
    		System.out.println("No matching transaction found.");
    	}
    	
    	return found; 
    }

    private double promptDouble(String prompt) {
        while (true) {
            System.out.print(prompt);
            try {
                return Double.parseDouble(sc.nextLine().trim());
            } catch (NumberFormatException e) {
                System.out.println("Please enter a valid number.");
            }
        }
    }

    private void printTitle() {
        System.out.println("=========================================");
        System.out.println("     Personal Finance Tracker            ");
        System.out.println("=========================================");
    }
}
