package service;

import model.Budget;
import model.Expense;
import model.User;

import java.io.*;
import java.util.ArrayList;
import java.util.List;

// herein, persistent data is managed
public class DataManager {
    // base dir = data/
    private static final String DATA_DIR = "data/";
    private static final String USERS_FILE = DATA_DIR + "users.csv";
    private static final String EXPENSES_DIR = DATA_DIR + "expenses/";
    private static final String BUDGETS_DIR = DATA_DIR + "budgets/";

    public DataManager() {
        // create new directories if they don't exist
        new File(DATA_DIR).mkdirs();
        new File(EXPENSES_DIR).mkdirs();
        new File(BUDGETS_DIR).mkdirs();
    }
    // load all users from "database" (i.e. users.csv)
    public List<User> loadUsers() {
        File usersFile = new File(USERS_FILE)
        // logging
    	System.out.println("Looking for: " + usersFile.getAbsolutePath())//.getAbsolutePath());
        
        List<User> users = new ArrayList<>();
        
        //File file = usersFile//new File(USERS_FILE);
        if (!usersFile.exists()) return users;

        FileReader fileReader = new FileReader(usersFile);
        try (BufferedReader reader = new BufferedReader(fileReader)) {//new FileReader(usersFile))) {
            String line;
            while ((line = reader.readLine()) != null) {
                if (line.isBlank()) continue;
                // instantiate user object from csv line
                User user = User.fromCSV(line);
                loadExpensesForUser(user);
                loadBudgetsForUser(user);
                // append 'users' to list
                users.add(user);
            }
        } catch (IOException e) {
            System.out.println("Warning: could not access file!.");
        }

        return users;
    }

    // save all the users to users.cs v
    public void saveUsers(List<User> users) {
        FileWriter fw = new FileWriter(USERS_FILE)
        try (PrintWriter writer = new PrintWriter(fw)) {//new FileWriter(USERS_FILE))) {
            for (User u:users) {
                // convert user Object to csv format
                writer.println(u.toCSV());
                saveExpensesForUser(u);
                saveBudgetsForUser(u);
            }
        } catch (IOException e) {
            System.out.println("Error: could not save users file.");
        }
    }

    // handling expenses
    private void loadExpensesForUser(User user) {
        File file = new File(EXPENSES_DIR + user.getUserId() + ".csv");
        if (!file.exists()) return;

        FileReader fr = new FileReader(file);
        try (BufferedReader reader = new BufferedReader(fr)) {
            String line;
            while ((line = reader.readLine()) != null) {
                if (!line.isBlank()) {
                    user.addExpense(Expense.fromCSV(line)); 
                }
            }
        } catch (IOException e) {
            System.out.println("Warning: could not load expenses for " + user.getUsername());
        }
    }

    private void saveExpensesForUser(User user) {
        try (PrintWriter writer = new PrintWriter(
                new FileWriter(EXPENSES_DIR + user.getUserId() + ".csv"))) {
            for (Expense e : user.getExpenses()) {
                writer.println(e.toCSV());
            }
        } catch (IOException e) {
            System.out.println("Error: unable to save expenses for " + user.getUsername());
        }
    }

    // BUDGETS
    private void loadBudgetsForUser(User user) {
        File file = new File(BUDGETS_DIR + user.getUserId() + ".csv");
        if (!file.exists()) return;

        try (BufferedReader reader = new BufferedReader(new FileReader(file))) {
            String line;
            while ((line = reader.readLine()) != null) {
                if (line.isBlank()) continue;
                Budget loaded = Budget.fromCSV(line);
                Budget existing = user.getBudget(loaded.getCategory());
                if (existing != null) {
                    existing.setLimit(loaded.getLimit());
                }
            }
        } catch (IOException e) {
            System.out.println("Error: unable to get load budgets for " + user.getUsername());
        }
    }

    private void saveBudgetsForUser(User user) {
        try (PrintWriter writer = new PrintWriter(
                new FileWriter(BUDGETS_DIR + user.getUserId() + ".csv"))) {
            for (Budget b : user.getBudgets()) {
                writer.println(b.toCSV());
            }
        } catch (IOException e) {
            System.out.println("Error: could not save budgets for " + user.getUsername());
        }
    }
}
